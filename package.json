{
  "name": "codex-xyz",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.3",
  "type": "module",
  "description": "Local Codex control plane prototype for managing multiple sessions.",
  "scripts": {
    "generate:codex": "node scripts/generate-codex-types.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "prebuild": "pnpm run generate:codex",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "tsx src/server/index.ts",
    "pretest": "pnpm run generate:codex",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
