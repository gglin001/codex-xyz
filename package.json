{
	"name": "codex-xyz",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.0.3",
	"type": "module",
	"description": "Codex control plane for managing multiple threads.",
	"scripts": {
		"generate:codex": "node scripts/generate-codex-types.mjs",
		"upgrade:v4": "node scripts/upgrade-v3-to-v4.mjs",
		"upgrade:v5": "node scripts/upgrade-v4-to-v5.mjs",
		"upgrade:v6": "node scripts/upgrade-v5-to-v6.mjs",
		"upgrade:v7": "node scripts/upgrade-v6-to-v7.mjs",
		"upgrade:v8": "node scripts/upgrade-v7-to-v8.mjs",
		"upgrade:v9": "node scripts/upgrade-v8-to-v9.mjs",
		"upgrade:v10": "node scripts/upgrade-v9-to-v10.mjs",
		"dev": "node scripts/run-dev.mjs",
		"prebuild": "pnpm run generate:codex",
		"build": "next build",
		"start": "node scripts/run-start.mjs",
		"pretest": "pnpm run generate:codex",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-serialize": "^0.14.0",
		"@xterm/addon-webgl": "^0.19.0",
		"@xterm/headless": "^6.0.0",
		"@xterm/xterm": "^6.0.0",
		"framer-motion": "^12.40.0",
		"lucide-react": "^0.468.0",
		"next": "^16.2.9",
		"node-pty": "^1.1.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"ws": "^8.21.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@tailwindcss/postcss": "^4.3.1",
		"@types/node": "^25.9.3",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@types/ws": "^8.18.1",
		"jsdom": "^27.3.0",
		"tailwindcss": "^4.3.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.15"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
