{
  "name": "codex-xyz",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.3",
  "type": "module",
  "description": "Codex control plane for managing multiple sessions.",
  "scripts": {
    "generate:codex": "node scripts/generate-codex-types.mjs",
    "dev": "node scripts/run-dev.mjs",
    "prebuild": "pnpm run generate:codex",
    "build": "next build",
    "start": "node scripts/run-start.mjs",
    "pretest": "pnpm run generate:codex",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.468.0",
    "next": "^16.2.9",
    "node-pty": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^27.3.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
